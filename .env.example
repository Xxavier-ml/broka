# Copy to .env and fill in real values — NEVER commit .env to git

# JWT secret — generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_char_random_string

# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# Database — SQLite for local dev; Render injects PostgreSQL automatically
DATABASE_URL=sqlite+aiosqlite:///./broka.db

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT expiry (minutes)
TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=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
